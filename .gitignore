# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data & results (regenerable / large / sensitive)
data/cache/
*.parquet
*.sqlite
*.db

# ...but DO commit the durable Databento archive: paid-for CME futures bars, zstd-compressed,
# canonical 1-minute. Committing it once means no workspace/clone ever re-burns free credits
# (see data/archive/databento/README.md). The negation must come after the *.parquet rule.
!data/archive/databento/**/*.parquet
# DO commit the durable Binance crypto archive (funding rates + spot/perp 8h + intraday OHLC),
# pulled once from free public APIs and reused offline by the crypto-$100K campaign
# (see docs/experiments/crypto_100k/README.md). Negations must come after the *.parquet rule.
!data/funding/**/*.parquet
!data/intraday/**/*.parquet

# Secrets — never commit API keys
.env
config/secrets.yaml

# OS / editor
.DS_Store
.idea/
.vscode/

# Notebooks
.ipynb_checkpoints/

# Codegraph index (local code-intelligence artifacts, regenerable)
.codegraph/
